# Range-Constraints — was der Code wirklich braucht.
# Lock-File `requirements-dev.txt` wird via `make lock` aus dieser Datei generiert
# (pip-compile --generate-hashes).
# CI installiert mit `pip install --require-hashes -r requirements-dev.txt`.

# --- Laufzeit (auch in manifest.json requirements gepflegt) ---
# Versionen aligned mit HA Core 2026.5.1 package_constraints.txt:
#   bleak==2.1.1, home-assistant-bluetooth==2.0.0
bleak>=2.1,<3
home-assistant-bluetooth>=2.0,<3

# --- Tests ---
# pytest and pytest-asyncio are pulled in transitively by
# pytest-homeassistant-custom-component, which pins them exactly. Declaring
# our own ranges leads to resolver conflicts — leave them to HA.
pytest-homeassistant-custom-component>=0.13

# HA Core 2026.5 unconditionally imports these in its `usb` component during
# module load. They are not picked up transitively by HA on macOS dev
# machines because the dependency is conditional (`platform_system == 'Linux'`
# in HA's setup), but our coordinator imports HA bluetooth which loads usb.
aiousbwatcher>=1.0
serialx>=1.0
# serialx imports aioesphomeapi from its esphome serial backend; HA Core
# does not mark this as a required dep on macOS so we pin it ourselves.
aioesphomeapi>=45

# --- Static Analysis / Lint ---
ruff>=0.5
mypy>=1.11

# --- Dev-Tooling ---
pip-tools>=7.4
